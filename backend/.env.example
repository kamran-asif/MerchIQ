# ------------------------------
# MerchIq - Retail Analytics Platform
# Environment Configuration
# ------------------------------

# App
APP_NAME=MerchIq - Retail Analytics Platform
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/merchiq
TEST_DATABASE_URL=sqlite:///./test.db

# LLM / AI APIs (Optional - fallback to rule-based if empty)
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=openai
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_SALES_TOPIC=sales-events
KAFKA_INVENTORY_TOPIC=inventory-events
KAFKA_PRICING_TOPIC=pricing-events
KAFKA_PROMOTION_TOPIC=promotion-events
KAFKA_ENABLED=false

# Redis / Caching
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Security
SECRET_KEY=change-this-in-production-32chars-minimum-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Business Logic Defaults
FORECAST_DEFAULT_DAYS=30
SAFETY_STOCK_Z_SCORE=1.65
PRICE_ELASTICITY_THRESHOLD=-0.5
